{
  "name": "library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs --optional && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local db/seed.mjs",
    "test:reserve": "node scripts/test-reserve.mjs",
    "test:books": "node --import ./scripts/helpers/register-test-db.mjs --test scripts/test-books.mjs",
    "test:waitlist": "node --import ./scripts/helpers/register-test-db.mjs --test scripts/test-waitlist.mjs",
    "test:admin-tools": "node --import ./scripts/helpers/register-test-db.mjs --test scripts/test-admin-tools.mjs",
    "test:admin": "node --import ./scripts/helpers/register-test-db.mjs --test scripts/test-admin-reservations.mjs",
    "test:env": "node --test scripts/test-env.mjs scripts/test-csv.mjs scripts/test-search.mjs scripts/test-babel.mjs scripts/test-babel-book.mjs scripts/test-reservation-params.mjs scripts/test-circulation-format.mjs scripts/test-reader-state.mjs scripts/test-reader-html.mjs scripts/test-account.mjs scripts/test-session-read.mjs scripts/test-motion-prefs.mjs scripts/test-book-shape.mjs scripts/test-ctos.mjs",
    "test:reading": "node --import ./scripts/helpers/register-test-db.mjs --test scripts/test-reading-access.mjs",
    "test:profile": "node --import ./scripts/helpers/register-test-db.mjs --test scripts/test-profile-db.mjs",
    "test:search-db": "node --test scripts/test-search-db.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.7.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "tailwindcss": "^4"
  },
  "packageManager": "pnpm@12.8.1"
}
