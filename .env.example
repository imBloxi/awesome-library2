# Neon database: the POOLED connection string (postgres://...) from the Neon Console.
# Use a Neon project in the same region as the app (Frankfurt, aws-eu-central-1).
DATABASE_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth URL (https://...) from Neon Console > Auth. NOT the Postgres connection string.
NEON_AUTH_BASE_URL=

# 32+ random characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Protects the daily expiry cron: openssl rand -hex 32
CRON_SECRET=

# On Vercel, tick the Production target for every variable above, then redeploy.
